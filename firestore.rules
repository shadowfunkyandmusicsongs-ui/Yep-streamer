rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isContentManager() {
      return hasRole('content_manager') || isAdmin();
    }

    function isCreator() {
      return hasRole('creator') || isContentManager();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isContentManager();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // User Public Profiles
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Catalog Content
    match /content/{contentId} {
      allow read: if resource.data.status == 'published' || isCreator();
      allow create: if isCreator();
      allow update: if isCreator() && (resource.data.creatorId == request.auth.uid || isContentManager());
      allow delete: if isContentManager();

      match /seasons/{seasonId} {
        allow read: if true;
        allow write: if isCreator() && (get(/databases/$(database)/documents/content/$(contentId)).data.creatorId == request.auth.uid || isContentManager());

        match /episodes/{episodeId} {
          allow read: if true;
          allow write: if isCreator() && (get(/databases/$(database)/documents/content/$(contentId)).data.creatorId == request.auth.uid || isContentManager());
        }
      }
    }

    // Reels (Short vertical videos)
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isCreator();
      allow update: if isAuthenticated(); // For likes counter and comments
      allow delete: if isOwner(resource.data.creatorId) || isContentManager();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(resource.data.userId) || isContentManager();
      }
    }

    // Watchlists & Favorites
    match /watchlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Watch Progress & Viewing History
    match /watchProgress/{userId} {
      allow read, write: if isOwner(userId);

      match /items/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Upload & Video Processing Jobs
    match /uploadJobs/{jobId} {
      allow read: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isContentManager());
      allow create: if isCreator() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isContentManager());
      allow delete: if isContentManager();
    }

    // Moderation & Copyright Reports
    match /moderationReports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isContentManager();
    }

    // Audit Logs (Sensitive actions tracking)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
