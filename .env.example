# ==========================================
# YEP Streamer Environment Configuration
# ==========================================

# Port for Express and Vite dev server
PORT=3000

# Base URL where this applet is hosted
APP_URL="http://localhost:3000"

# Gemini AI API Key (Official @google/genai SDK)
# Used server-side for AI catalog discovery, recommendations, and search assistance.
# In Google AI Studio, injected automatically via user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ------------------------------------------
# Firebase Client Configuration (Optional / Production)
# ------------------------------------------
# Get these from your Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY="AIzaSyPlaceholderKeyForYepStreamer"
VITE_FIREBASE_AUTH_DOMAIN="yep-streamer.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="yep-streamer"
VITE_FIREBASE_STORAGE_BUCKET="yep-streamer.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ------------------------------------------
# Video Processing & CDN Worker (Optional / Production)
# ------------------------------------------
# Base URL for authenticated HLS manifest & segment delivery
CDN_BASE_URL=""
# Remote FFmpeg Worker URL (e.g., Cloud Run worker service)
FFMPEG_WORKER_ENDPOINT=""
FFMPEG_WORKER_SECRET=""
